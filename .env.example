# Qdrant Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=media_embeddings

# Path to your photo library
MEDIA_ROOT=/path/to/your/photos

# Django
SECRET_KEY=dev-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Authentication (run `./manage create_user` after setting these)
LS_USERNAME=admin
LS_PASSWORD=changeme

# Override SQLite data dir (default: project root)
# LATENT_SEARCH_DATA=./data

# HuggingFace model cache (overridden by docker-compose)
# HF_HOME=~/.cache/huggingface
